types
  BranchName : atomic
  Branches : list of Tip by BranchName
  FileState : sum of Untracked, Unmodified, Modified, Staged, StagedAndModified, Conflicted
  Files : list of FileState by Path
  Hash : atomic
  Head : sum of Unborn, OnBranch, Detached
  MergeHead : newtype of Hash
  Onto : newtype of Hash
  Operation : sum of Idle, Merging, Rebasing
  Path : atomic
  Paths : list of Path
  Remaining : list of Hash
  Repository : sum of Uninitialized, Initialized
  Tip : newtype of Hash
variants
  Conflicted : FileState
  Detached : Head
  Idle : Operation
  Initialized : Repository
  Merging : Operation
  Modified : FileState
  OnBranch : Head
  Rebasing : Operation
  Staged : FileState
  StagedAndModified : FileState
  Unborn : Head
  Uninitialized : Repository
  Unmodified : FileState
  Untracked : FileState
constants
events
  add : 1 transition
  checkoutCommit : 1 transition
  commit : 2 transitions
  edit : 2 transitions
  init : 1 transition
  merge : 1 transition
  mergeAbort : 1 transition
  mergeConflicted : 1 transition
  mergeContinue : 1 transition
  rebase : 1 transition
  rebaseAbort : 1 transition
  rebaseContinue : 1 transition
  rebaseFinished : 1 transition
  resolve : 1 transition
  restore : 2 transitions
  switch : 1 transition
  unstage : 1 transition
annotations
root Repository
