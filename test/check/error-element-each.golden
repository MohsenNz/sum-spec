test/check/error-element-each.sumspec:20:36:
   |
20 | targetOnly :: Files -> Files[each #p](FileState.Unmodified)
   |                                    ^
on the target side, write Files[p]; each #p names the key on the source side

test/check/error-element-each.sumspec:22:61:
   |
22 | repeated :: Files[each #p](FileState.Staged) -> Files[each #p](FileState.Unmodified)
   |                                                             ^
on the target side, write Files[p]; each #p names the key on the source side

test/check/error-element-each.sumspec:24:44:
   |
24 | inGuard :: App => Mode.Idle // Files[each #p](FileState.Staged) -> Mode.Busy
   |                                            ^
a guard can't pick elements with Files[each #p]; write it on the source side

test/check/error-element-each.sumspec:27:58:
   |
27 |   :: App(Files[each #p](FileState.Staged) * Others[each #q in ps])
   |                                                          ^
a transition picks several elements once; Files[each #p] already does here

test/check/error-element-each.sumspec:30:12:
   |
30 | notList :: Mode[each #m] => Idle -> Busy
   |            ^
Mode is not a list type; [each #m] picks elements of a keyed list type, such as L = [T by K]

test/check/error-element-each.sumspec:32:12:
   |
32 | unkeyed :: Sizes[each #p](#n) -> Sizes[p](n + 1)
   |            ^
Sizes has no key, so [each #p] can't pick elements; declare one, such as Sizes = [Size by Id]

test/check/error-element-each.sumspec:32:34:
   |
32 | unkeyed :: Sizes[each #p](#n) -> Sizes[p](n + 1)
   |                                  ^
Sizes has no key, so [p] can't pick an element; declare one, such as Sizes = [Size by Id]

test/check/error-element-each.sumspec:34:37:
   |
34 | primed :: Files[each #p] -> Files[p]'
   |                                     ^
an element takes no prime ('); prime its parts instead, such as Files[x](A')

test/check/error-element-each.sumspec:35:25:
   |
35 | named :: Files[each #p]#f -> Files
   |                         ^
an element can't be named yet; name its parts instead

test/check/error-element-each.sumspec:37:29:
   |
37 | twice Path#p :: Files[each #p] => FileState.Staged -> FileState.Unmodified
   |                             ^
p is named twice in this transition

test/check/error-element-each.sumspec:39:19:
   |
39 | input Files[each #p] :: Mode.Idle -> Mode.Busy
   |                   ^
an element path goes on the source or target side, not in the input

test/check/error-element-each.sumspec:41:33:
   |
41 | unnamedTarget :: Files -> Files[each](FileState.Unmodified)
   |                                 ^
on the target side, Files[each] can't be written; name the key on the source side, Files[each #p], and write Files[p] here

test/check/error-element-each.sumspec:43:43:
   |
43 | unnamedGuard :: App => Mode.Idle // Files[each](FileState.Staged) -> Mode.Busy
   |                                           ^
a guard can't pick elements with Files[each]; write it on the source side

test/check/error-element-each.sumspec:45:54:
   |
45 | unnamedUse :: Files[each](FileState.Staged) -> Files[p](FileState.Unmodified)
   |                                                      ^
unknown name p; name a value with #p in the input or on the source side

