-- An element path over each element that matches, L[#x]: a filter on the
-- source side, so the transition happens even when nothing matches. x
-- names each element's key, and the target may pick it with L[x].
__atomics { Path  Size = __int }
__events { commit abort clear grow reset }

__init :: App

App = Files * Sizes * Mode
Files = [FileState by Path]
FileState = Unmodified | Staged | Conflicted
Sizes = [Size by Path]
Mode = Idle | Busy

-- In a shared path, for both sides.
commit :: Files[#p] => FileState.Staged -> FileState.Unmodified

-- Named on the source side, used on the target, under an outer shared
-- path.
abort
  :: App
  => Files[#p](FileState.Conflicted) * Mode.Busy
  -> Files[p](FileState.Unmodified) * Mode.Idle

-- Without arguments on the source: every element. The target picks each
-- with L[x].
clear :: Files[#i] -> Files[i](FileState.Unmodified)

-- A name bound inside is per element.
grow :: Sizes[#p](#n) -> Sizes[p](n + 1)

-- Each element keeps its value when the target says nothing about it.
reset :: App => Files[#p] * Mode.Busy -> Mode.Idle
