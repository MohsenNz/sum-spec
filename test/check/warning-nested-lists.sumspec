-- Written from the element, a key picks only the innermost element; the
-- checker warns about the outer one, and suggests element paths.
__version 1.0

__atomics { ProjectId TodoId }
__events { toggle }

__init :: App

App = Projects
Projects = [Project]
Project = ProjectId * Todos
Todos = [Todo]
Todo = TodoId * Done
Done = No | Yes

toggle TodoId#t :: Todo(t * Done.No) -> Todo(Done.Yes)
