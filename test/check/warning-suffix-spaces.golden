test/check/warning-suffix-spaces.sumspec:14:24:
   |
14 | primed :: App -> App(A ')
   |                        ^
warning: a prime (') goes right after its name, with no space: write A'

test/check/warning-suffix-spaces.sumspec:15:12:
   |
15 | named Text #t :: Holder.Empty -> Holder.Full(t)
   |            ^
warning: #t goes right after the pattern it names, with no space: write Text#t

test/check/warning-suffix-spaces.sumspec:16:15:
   |
16 | inArgs Ref(Id #i * Name#n) :: App -> App
   |               ^
warning: #i goes right after the pattern it names, with no space: write Id#i

test/check/warning-suffix-spaces.sumspec:17:32:
   |
17 | afterParens Ref(Id#i * Name#n) #r :: App -> App
   |                                ^
warning: #r goes right after the pattern it names, with no space

test/check/warning-suffix-spaces.sumspec:18:17:
   |
18 | tabbed Text	#t :: Holder.Empty -> Holder.Full(t)
   |                 ^
warning: #t goes right after the pattern it names, with no space: write Text#t

test/check/warning-suffix-spaces.sumspec:20:1:
   |
20 | ')
   | ^
warning: a prime (') goes right after its name, with no space: write A'

