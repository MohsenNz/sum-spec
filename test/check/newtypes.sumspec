-- A newtype is a type of its own: it may share a product with its base,
-- and it takes one argument headed by its base type.
__atomics { Timestamp Point }
__txs { t }

App = Event * Boundary
Event = At * Timestamp
At = Timestamp
Boundary = Ring
Ring = Partial [Point] | Enclosed [Point]

t :: App(Event * Boundary(Ring.Partial)) -> App(Event * Boundary(Ring.Enclosed))
