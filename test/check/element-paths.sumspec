-- An element path, L[x], picks the element of the keyed list type L whose
-- key equals x. Paths nest, so an element of an outer list can be picked
-- too. None of these warn.
__version 1.0

__atomics { ProjectId TodoId Path Text }
__events { toggle rename remove keep stage }

App = Projects * Selected * Files
Projects = [Project by ProjectId]
Project = Name * Todos
Name = Text
Todos = [Todo by TodoId]
Todo = Title * Done
Title = Text
Done = No | Yes
Selected = None | One ProjectId
Ref = ProjectId * TodoId
Files = [FileState by Path]
FileState = Modified | Staged

-- Nested: the project p, and the todo t inside it.
toggle Ref(ProjectId#p * TodoId#t)
  :: App(Projects[p](Todos[t](Done.No)))
  -> App(Projects[p](Todos[t](Done.Yes)))
-- The key may also be named on the source side.
rename :: App(Selected.One(ProjectId#p)) -> App(Projects[p](Todos'))
-- Without arguments: a precondition that the element exists.
remove ProjectId#p :: App(Projects[p]) -> App(Projects')
-- On the target, an element without arguments keeps its value.
keep ProjectId#p :: Projects[p](Todos) -> Projects[p]
-- An element that isn't a product takes one argument, headed by its type.
stage Path#p :: Files[p](FileState.Modified) -> Files[p](FileState.Staged)
