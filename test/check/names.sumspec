-- Named values: given in the input or on the source side, used on
-- either side. Newtypes are strict: unwrap and wrap to change the type.
__version 1.1

__atomics { Id Text }
__txs { finish select keep reset }

App = Todos * Selection
Todos = [Todo]
Todo = Id * Title * Mode
Title = Text
EditText = Text
Mode = Viewing | Editing EditText
Selection = None | Some Id | Many [Id]
Ref = Id * Title

finish Id#id :: Todo(id * Mode.Editing(EditText(Text#e)))
             -> Todo(Title(e) * Mode.Viewing)
select Ref(Id#i * Title#t) :: Selection -> Selection.Some(i)
select Ref(Id#j) :: Selection.Some(j) -> Selection.None
keep [Id]#ids :: Selection.None -> Selection.Many(ids)
reset :: App(Selection.Some#s) -> App(Selection.None)
