test/check/error-bad-path.sumspec:12:20:
   |
12 | notVariant :: Page.Nope -> Page.Home
   |                    ^
Nope is not a variant of Page

test/check/error-bad-path.sumspec:13:15:
   |
13 | onAtomic :: A.X -> A
   |               ^
A has no variants, so .X is invalid

test/check/error-bad-path.sumspec:14:18:
   |
14 | onProduct :: App.Page -> App
   |                  ^
App has no variants, so .Page is invalid

test/check/error-bad-path.sumspec:16:29:
   |
16 | throughPayload :: Page.Plan.Map -> Page.Home
   |                             ^
Page.Plan carries Mode and has no variants of its own; write Page.Plan(Mode.Map)

test/check/error-bad-path.sumspec:18:25:
   |
18 | throughNewtype :: Alias.Home -> Alias
   |                         ^
Alias carries Page and has no variants of its own; write Alias(Page.Home)

