-- Errors in element paths, L[x].
__version 1.2

__atomics { Id Other Text }
__txs { notList variant unkeyed wrongKey sumArgs primed named input unknown }

App = Items * Ring * Plain * States
Items = [Item by Id]
Item = Name * State
Name = Text
State = Off | On
Ring = Open | Points [Item by Id]
Plain = [Item]
States = [State by Id]

-- Item is not a list type.
notList Id#i :: Item[i](State.Off) -> Item[i](State.On)
-- Only a named list type, not a variant's list.
variant Id#i :: Ring.Points[i] -> Ring.Points[i]
-- Plain has no key.
unkeyed Id#i :: Plain[i] -> Plain[i]
-- The key of Items is Id, not Other.
wrongKey Other#o :: Items[o] -> Items[o]
-- A State is a sum: its element takes one argument headed by State.
sumArgs Id#i :: States[i](State.Off * Name) -> States[i](Off)
-- An element takes no prime.
primed Id#i :: Items[i] -> Items[i]'
-- An element can't be named yet.
named Id#i :: Items[i]#x -> Items[i]
-- Not in the input.
input Items[i] :: Items -> Items'
-- An unknown key.
unknown :: Items[k](State.Off) -> Items[k](State.On)
