-- An event may take an input, written after its name.
__version 1.0

__atomics { Id Text }
__events { rename pick select }

__init :: App

App = Items * Selection
Items = [Item]
Item = Id * Name * State
Name = Text
State = Off | On
Selection = None | Some Id
Ids = [Id]
Ref = Id * Name

rename Name :: Item(Name) -> Item(Name')
pick Ids :: Selection.None -> Selection.Some(Id)
-- Every transition writes the input.
select Ref :: State.Off -> State.On
           :: State.On -> State.Off
