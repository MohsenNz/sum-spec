test/check/error-element-paths.sumspec:17:17:
   |
17 | notList Id#i :: Item[i](State.Off) -> Item[i](State.On)
   |                 ^
Item is not a list type; [i] picks an element of a keyed list type, such as Todos = [Todo by TodoId]

test/check/error-element-paths.sumspec:17:39:
   |
17 | notList Id#i :: Item[i](State.Off) -> Item[i](State.On)
   |                                       ^
Item is not a list type; [i] picks an element of a keyed list type, such as Todos = [Todo by TodoId]

test/check/error-element-paths.sumspec:19:22:
   |
19 | variant Id#i :: Ring.Points[i] -> Ring.Points[i]
   |                      ^
an element path starts at a list type, not at a variant; write Ring.Points(Items[i](...))

test/check/error-element-paths.sumspec:19:40:
   |
19 | variant Id#i :: Ring.Points[i] -> Ring.Points[i]
   |                                        ^
an element path starts at a list type, not at a variant; write Ring.Points(Items[i](...))

test/check/error-element-paths.sumspec:21:17:
   |
21 | unkeyed Id#i :: Plain[i] -> Plain[i]
   |                 ^
Plain has no key, so [i] can't pick an element; declare one, such as Plain = [Item by Id]

test/check/error-element-paths.sumspec:21:29:
   |
21 | unkeyed Id#i :: Plain[i] -> Plain[i]
   |                             ^
Plain has no key, so [i] can't pick an element; declare one, such as Plain = [Item by Id]

test/check/error-element-paths.sumspec:23:27:
   |
23 | wrongKey Other#o :: Items[o] -> Items[o]
   |                           ^
o has type Other, but the key of Items is Id

test/check/error-element-paths.sumspec:23:39:
   |
23 | wrongKey Other#o :: Items[o] -> Items[o]
   |                                       ^
o has type Other, but the key of Items is Id

test/check/error-element-paths.sumspec:25:17:
   |
25 | sumArgs Id#i :: States[i](State.Off * Name) -> States[i](Off)
   |                 ^
an element of States takes one argument, State, but 2 are given

test/check/error-element-paths.sumspec:25:58:
   |
25 | sumArgs Id#i :: States[i](State.Off * Name) -> States[i](Off)
   |                                                          ^
expected State here, not Off

test/check/error-element-paths.sumspec:27:36:
   |
27 | primed Id#i :: Items[i] -> Items[i]'
   |                                    ^
an element takes no prime ('); prime its parts instead, such as Items[x](A')

test/check/error-element-paths.sumspec:29:24:
   |
29 | named Id#i :: Items[i]#x -> Items[i]
   |                        ^
an element can't be named yet; name its parts instead

test/check/error-element-paths.sumspec:31:13:
   |
31 | input Items[i] :: Items -> Items'
   |             ^
an element path goes on the source or target side, not in the input

test/check/error-element-paths.sumspec:33:18:
   |
33 | unknown :: Items[k](State.Off) -> Items[k](State.On)
   |                  ^
unknown name k; name a value with #k in the input or on the source side

test/check/error-element-paths.sumspec:33:41:
   |
33 | unknown :: Items[k](State.Off) -> Items[k](State.On)
   |                                         ^
unknown name k; name a value with #k in the input or on the source side

