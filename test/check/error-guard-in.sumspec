-- Memberships that break the rules.
__atomics { Id  Other  Percent = __float  Name = __text  Key }
__events { notlist unknownlist unknownleft wrongelement wrongitem literal variant literalproduct text }

__init :: App

App = Ids * Names * Boxes * Todos * Nest * Count * Labels
Ids = [Id]
Names = [Name]
Box = Id * Name
Boxes = [Box]
Todo = Id * Name
Todos = [Todo by Key]
Labels = [Name by Key]
Nest = [Ids]
Count = Percent

notlist Id#i :: App => Count#c // i in c -> Count'
unknownlist Id#i :: App => Ids // i in nope -> Ids'
unknownleft :: App => Ids#ids // nope in ids -> Ids'
wrongelement Other#o :: App => Ids#ids // o in ids -> Ids'
wrongitem Key#k :: App => Labels#ls // k in ls -> Labels'
literal :: App => Ids#ids // 3 in ids -> Ids'
variant :: App => Names#ns // Missing.Value in ns -> Names'
literalproduct :: App => Boxes#bs // 3 in bs -> Boxes'
text :: App => Names#ns // 3 in ns -> Names'
