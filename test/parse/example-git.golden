__version 1.0

__atomics {
  Hash
  BranchName
  Path
}

__events {
  init
  edit
  add
  unstage
  restore
  commit
  switch
  checkoutCommit
  merge
  resolve
  mergeContinue
  mergeAbort
  rebase
  rebaseContinue
  rebaseAbort
}

__init :: Repository.Uninitialized
Repository = Uninitialized | Initialized (Head * Branches * Files * Operation)
Head = Unborn BranchName | OnBranch BranchName | Detached Hash
Branches = [Tip by BranchName]
Tip = Hash
Files = [FileState by Path]
FileState = Untracked | Unmodified | Modified | Staged | StagedAndModified | Conflicted
Operation = Idle | Merging MergeHead | Rebasing (Onto * Remaining)
MergeHead = Hash
Onto = Hash
Remaining = [Hash]
init :: Repository.Uninitialized -> Repository.Initialized(Head.Unborn * Operation.Idle)
edit Path#p :: Files[p](FileState.Unmodified) -> Files[p](FileState.Modified)
            :: Files[p](FileState.Staged) -> Files[p](FileState.StagedAndModified)
add Path#p :: Files[p](FileState.Untracked) -> Files[p](FileState.Staged)
           :: Files[p](FileState.Modified) -> Files[p](FileState.Staged)
           :: Files[p](FileState.StagedAndModified) -> Files[p](FileState.Staged)
unstage Path#p :: Files[p](FileState.Staged) -> Files[p](FileState.Modified)
               :: Files[p](FileState.StagedAndModified) -> Files[p](FileState.Modified)
restore Path#p :: Files[p](FileState.Modified) -> Files[p](FileState.Unmodified)
               :: Files[p](FileState.StagedAndModified) -> Files[p](FileState.Staged)
commit :: Repository.Initialized(Head.Unborn * Operation.Idle) -> Repository.Initialized(Head.OnBranch * Branches' * Files')
       :: Repository.Initialized(Head.OnBranch * Operation.Idle) -> Repository.Initialized(Branches' * Files')
       :: FileState.Staged -> FileState.Unmodified
switch :: Repository.Initialized(Operation.Idle) -> Repository.Initialized(Head.OnBranch * Files')
checkoutCommit :: Repository.Initialized(Operation.Idle) -> Repository.Initialized(Head.Detached * Files')
merge :: Repository.Initialized(Head.OnBranch * Operation.Idle) -> Repository.Initialized(Branches' * Files')
      :: Repository.Initialized(Head.OnBranch * Operation.Idle) -> Repository.Initialized(Files' * Operation.Merging)
      :: FileState.Unmodified -> FileState.Conflicted
resolve Path#p :: Files[p](FileState.Conflicted) -> Files[p](FileState.Staged)
mergeContinue :: Repository.Initialized(Operation.Merging) -> Repository.Initialized(Branches' * Operation.Idle)
mergeAbort :: Repository.Initialized(Operation.Merging) -> Repository.Initialized(Files' * Operation.Idle)
           :: FileState.Conflicted -> FileState.Unmodified
rebase :: Repository.Initialized(Head.OnBranch * Operation.Idle) -> Repository.Initialized(Head.Detached * Files' * Operation.Rebasing)
rebaseContinue :: Repository.Initialized(Head.Detached * Operation.Rebasing) -> Repository.Initialized(Head.Detached(Hash') * Files' * Operation.Rebasing(Remaining'))
               :: Repository.Initialized(Head.Detached * Operation.Rebasing) -> Repository.Initialized(Head.OnBranch * Branches' * Operation.Idle)
rebaseAbort :: Repository.Initialized(Head.Detached * Operation.Rebasing) -> Repository.Initialized(Head.OnBranch * Files' * Operation.Idle)
