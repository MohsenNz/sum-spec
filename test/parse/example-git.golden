__version 1.0

__atomics {
  Hash
  BranchName
  Path
}

__events {
  init
  edit
  add
  unstage
  restore
  commit
  switch
  checkoutCommit
  merge
  mergeConflicted
  resolve
  mergeContinue
  mergeAbort
  rebase
  rebaseContinue
  rebaseFinished
  rebaseAbort
}

__init :: Repository.Uninitialized
Repository = Uninitialized | Initialized (Head * Branches * Files * Operation)
Head = Unborn BranchName | OnBranch BranchName | Detached Hash
Branches = [Tip by BranchName]
Tip = Hash
Files = [FileState by Path]
FileState = Untracked | Unmodified | Modified | Staged | StagedAndModified | Conflicted
Operation = Idle | Merging MergeHead | Rebasing (Onto * Remaining)
MergeHead = Hash
Onto = Hash
Remaining = [Hash]
Paths = [Path]
init :: Repository.Uninitialized -> Repository.Initialized(Head.Unborn * Operation.Idle)
edit Path#p :: Files[p]
            => FileState.Unmodified -> FileState.Modified
            => FileState.Staged -> FileState.StagedAndModified
add Path#p :: Files[p] => FileState.{Untracked | Modified | StagedAndModified} -> FileState.Staged
unstage Path#p :: Files[p] => FileState.{Staged | StagedAndModified} -> FileState.Modified
restore Path#p :: Files[p]
               => FileState.Modified -> FileState.Unmodified
               => FileState.StagedAndModified -> FileState.Staged
commit :: Repository.Initialized
       => Head.Unborn * Operation.Idle * Files[each #p](FileState.Staged) -> Head.OnBranch * Branches' * Files[p](FileState.Unmodified)
       => Head.OnBranch * Operation.Idle * Files[each #p](FileState.Staged) -> Branches' * Files[p](FileState.Unmodified)
switch BranchName#b :: Repository.Initialized => Operation.Idle // Branches[b] -> Head.OnBranch(b) * Files'
checkoutCommit :: Repository.Initialized => Operation.Idle -> Head.Detached * Files'
merge :: Repository.Initialized => Head.OnBranch * Operation.Idle -> Branches' * Files'
mergeConflicted Paths#ps :: Repository.Initialized => Head.OnBranch * Files[each #p in ps](FileState.Unmodified) * Operation.Idle -> Files[p](FileState.Conflicted) * Operation.Merging
resolve Path#p :: Files[p] => FileState.Conflicted -> FileState.Staged
mergeContinue :: Repository.Initialized => Operation.Merging -> Branches' * Operation.Idle
mergeAbort :: Repository.Initialized => Operation.Merging * Files[each #p](FileState.Conflicted) -> Files[p](FileState.Unmodified) * Operation.Idle
rebase :: Repository.Initialized => Head.OnBranch * Operation.Idle -> Head.Detached * Files' * Operation.Rebasing
rebaseContinue :: Repository.Initialized => Head.Detached * Operation.Rebasing -> Head.Detached(Hash') * Files' * Operation.Rebasing(Remaining')
rebaseFinished :: Repository.Initialized => Head.Detached * Operation.Rebasing -> Head.OnBranch * Branches' * Operation.Idle
rebaseAbort :: Repository.Initialized => Head.Detached * Operation.Rebasing -> Head.OnBranch * Files' * Operation.Idle
