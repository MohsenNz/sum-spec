__atomics {
  Port = __int
  Text
}

__events {
  open
  tick
  share
}

__annotations {
  @default
  @range
  @control
  @status
  @from
  @unless
  @announce
  @effect
}

__init :: App(Screen.Home)
App = Screen * Settings @control form
Screen @default Home = Home @control tab "Home | start" | Busy (Loading @status loading | Failed Text @status error) | Detail Info @from Settings
Settings = PortSetting @control stepper * Info
PortSetting @default 14550 @range 1..65535 = Port
Info @control text_field = Text
Mode = On | Off
Level @default Low = Low | High
open :: Screen.Home -> Screen.Busy @control button @effect log "opened"
     :: Screen.Busy -> Screen.Home @unless ( Screen.Home * Settings ) @announce
tick :: App
     => Screen.Home -> Screen.Busy @announce
     => Screen.Busy -> Screen.Home
share :: Screen.Home -> Screen.Detail @effect share(file, [Text])
