-- An element path over several elements, L[each #x in xs]: in a
-- pattern, in a shared path, nested in an argument, and with arguments.
-- The printer writes one space between words. L[each in xs] names no
-- key.
__version 1.0

__atomics { Path BranchName Hash }
__events { conflict tag move mark }

App = Files * Branches
Files = [FileState by Path]
FileState = Unmodified | Conflicted
Branches = [Tip by BranchName]
Tip = Hash
Paths = [Path]
Names = [BranchName]

conflict Paths#ps :: Files[each #p in ps] => FileState.Unmodified -> FileState.Conflicted
tag Names#bs :: App(Branches[ each #b   in bs ]) -> App(Branches[b](Tip'))
move Names#bs
  :: Branches[each #b in bs](Tip#h)
  -> Branches[b](Tip(h))
mark Paths#ps :: Files[each   in ps] => FileState.Unmodified -> FileState.Conflicted
