-- A keyed list, [T by K], is a list whose elements are identified by a
-- unique key of type K (added in 1.2). "by" is a word only inside the
-- brackets, so it can still be a name elsewhere.
__version 1.2

__atomics { Id Row Cell }
__txs { by }

App = Items * Shape * Grid
Items = [Item by Id]
Item = Row * Cell
Shape = Empty | Rows [Row by Id]
Grid = [[Cell] by Id]

by Id#by :: App(Items[by] * Shape.Rows([Row by Id])) -> App(Items[by] * Shape.Rows([Row  by  Id]))
