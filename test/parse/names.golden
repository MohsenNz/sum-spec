__version 1.0

__atomics {
  Id
  Text
}

__txs {
  rename
  select
  keep
  copy
}

App = Items * Selection
Items = [Item]
Item = Id * Name * State
Name = Text
State = Off | On
Selection = None | Some Id | Many [Id]
Ref = Id * Name
rename Text#t :: Item(Name(Text#old)) -> Item(Name(t))
select Ref(Id#i * Name#n) :: Item(i * State.Off) -> Item(State.On)
select Ref(Id#i * Name#n) :: Selection -> Selection.Some(i)
keep [Id]#ids :: Selection.None -> Selection.Many(ids)
copy :: Item(State.On#s * Name#n) -> Item(State.Off)
