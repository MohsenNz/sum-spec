__version 1.0

__atomics {
  Text = __text
  Count = __int
  TodoId
}

__events {
  startTyping
  addTodo
  toggleTodo
  toggleAll
  startEditing
  finishEditing
  cancelEditing
  deleteTodo
  clearCompleted
  showAll
  showActive
  showCompleted
}

__init :: App(Screen.NoTodos * NewTodo.Blank * Filter.All)
App = Screen * NewTodo * Filter
NewTodo = Blank | Typing Text
Screen = NoTodos | WithTodos (Todos * ToggleAll * Footer)
Todos = [Todo by TodoId]
Todo = Title * Completion * RowMode
Title = Text
Completion = Active | Completed
RowMode = Viewing | Editing EditText
EditText = Text
ToggleAll = NotAllDone | AllDone
Footer = ItemsLeft * ClearCompleted
ItemsLeft = Count
ClearCompleted = Hidden | Shown
Filter = All | Active | Completed
startTyping Text#t :: NewTodo.Blank -> NewTodo.Typing(t)
addTodo :: App
        => Screen.NoTodos * NewTodo.Typing(#text) // text != "" -> Screen.WithTodos(ToggleAll.NotAllDone) * NewTodo.Blank
        => Screen.WithTodos * NewTodo.Typing(#text) // text != "" -> Screen.WithTodos(Todos' * ToggleAll.NotAllDone * Footer(ItemsLeft')) * NewTodo.Blank
toggleTodo TodoId#id :: Todos[id]
                     => Completion.Active -> Completion.Completed
                     => Completion.Completed -> Completion.Active
toggleAll :: ToggleAll.NotAllDone -> ToggleAll.AllDone
          :: ToggleAll.AllDone -> ToggleAll.NotAllDone
startEditing TodoId#id :: Todos[id] => Title(#title) * RowMode.Viewing -> RowMode.Editing(EditText(title))
finishEditing TodoId#id :: Todos[id] => RowMode.Editing(EditText(#e)) -> Title(e) * RowMode.Viewing
cancelEditing TodoId#id :: Todos[id] => RowMode.Editing -> RowMode.Viewing
deleteTodo TodoId#id :: Screen.WithTodos => Todos[id] -> Todos' * ToggleAll' * Footer'
                     :: Screen.WithTodos(Todos[id]) -> Screen.NoTodos
clearCompleted :: Screen.WithTodos => Footer(ClearCompleted.Shown) -> Todos' * ToggleAll.NotAllDone * Footer(ClearCompleted.Hidden)
               :: Screen.WithTodos(Footer(ClearCompleted.Shown)) -> Screen.NoTodos
showAll :: Filter -> Filter.All
showActive :: Filter -> Filter.Active
showCompleted :: Filter -> Filter.Completed
