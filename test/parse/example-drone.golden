__version 1.0

__atomics {
  Meters
  Hectares
  Timestamp
  Text
  FailureReason
  Point
  Settings
}

__events {
  goToPlan
  goToDevices
  planBackToHome
  devicesBackToHome
  newPlot
  showMission
  selectMission
  editMission
  startFlight
  takeOff
  flightFailed
  landed
  dismissFailure
}

__init :: App(Page.Home)
App = Page * Settings
Page = Home | Plan (PMode * Missions) | Devices
PMode = JustMap | Plot (PlotOrigin * Plot) | Flight Flight | ShowMission (List (Empty | NonEmpty MissionSummaries) | Selected Mission)
Flight = Arming | Flying | Failed FailureReason
MissionSummaries = [MissionSummary]
MissionSummary = MissionName * At * Area * Distance * MissionState
PlotOrigin = Draft | Editing
Missions = [Mission]
Mission = MissionName * At * Area * Distance * MissionState * Plot
MissionName = Text
At = Timestamp
Area = Hectares
Distance = Meters
MissionState = NotStarted | Completed | Stopped (StopReason * BreakPoint)
StopReason = Commanded | BatteryLow | LinkLost
BreakPoint = Point
Plot = Empty | Drawn (Boundary * Markings)
Boundary = Ring
Markings = [Marking]
Marking = Obstacle Ring | RoundObstacle Spot | PowerLine Path | NonSprayArea Ring | MarkPoint Spot
Ring = Partial Points | Closeable Points | Enclosed Points
Path = Partial Point | Total Points
Points = [Point]
Spot = Point
goToPlan :: Page.Home -> Page.Plan(PMode.JustMap * Missions)
goToDevices :: Page.Home -> Page.Devices
planBackToHome :: Page.Plan(PMode.JustMap * Missions) -> Page.Home
devicesBackToHome :: Page.Devices -> Page.Home
newPlot :: Page.Plan(PMode.JustMap * Missions) -> Page.Plan(PMode.Plot(PlotOrigin.Draft * Plot.Empty) * Missions)
        :: Page.Plan(PMode.ShowMission.List * Missions) -> Page.Plan(PMode.Plot(PlotOrigin.Draft * Plot.Empty) * Missions)
showMission :: Page.Plan(PMode.JustMap * Missions) -> Page.Plan(PMode.ShowMission.List * Missions)
selectMission :: Page.Plan(PMode.ShowMission.List.NonEmpty) -> Page.Plan(PMode.ShowMission.Selected)
editMission :: Page.Plan(PMode.ShowMission.Selected(Mission(Plot#p))) -> Page.Plan(PMode.Plot(PlotOrigin.Editing * p))
startFlight :: Page.Plan(PMode.Plot(Plot.Drawn(Boundary(Ring.Enclosed)))) -> Page.Plan(PMode.Flight(Flight.Arming))
takeOff :: Flight.Arming -> Flight.Flying
flightFailed FailureReason#r :: Flight.Arming -> Flight.Failed(r)
                             :: Flight.Flying -> Flight.Failed(r)
landed :: Page.Plan(PMode.Flight(Flight.Flying)) -> Page.Plan(PMode.JustMap * Missions')
dismissFailure :: Page.Plan(PMode.Flight(Flight.Failed)) -> Page.Plan(PMode.JustMap)
