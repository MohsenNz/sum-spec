__version 1.0

__atomics {
  Meters
  Hectares
  Timestamp
  Text
  FailureReason
  Point
  Settings
  BatteryCharge = __float
}

__events {
  goToPlan
  goToDevices
  planBackToHome
  devicesBackToHome
  newPlot
  showMission
  selectMission
  editMission
  startFlight
  takeOff
  flightFailed
  landed
  dismissFailure
  batteryChanged
}

__init :: App(Page.Home)
App = Page * Settings * BatteryCharge
Page = Home | Plan (PMode * Missions) | Devices
PMode = JustMap | Plot (PlotOrigin * Plot) | Flight Flight | ShowMission (List (Empty | NonEmpty MissionSummaries) | Selected Mission)
Flight = Arming | Flying | Failed FailureReason
MissionSummaries = [MissionSummary]
MissionSummary = MissionName * At * Area * Distance * MissionState
PlotOrigin = Draft | Editing
Missions = [Mission]
Mission = MissionName * At * Area * Distance * MissionState * Plot
MissionName = Text
At = Timestamp
Area = Hectares
Distance = Meters
MissionState = NotStarted | Completed | Stopped (StopReason * BreakPoint)
StopReason = Commanded | BatteryLow | LinkLost
BreakPoint = Point
Plot = Empty | Drawn (Boundary * Markings)
Boundary = Ring
Markings = [Marking]
Marking = Obstacle Ring | RoundObstacle Spot | PowerLine Path | NonSprayArea Ring | MarkPoint Spot
Ring = Partial Points | Closeable Points | Enclosed Points
Path = Partial Point | Total Points
Points = [Point]
Spot = Point
MinTakeoffCharge = BatteryCharge(20)
goToPlan :: Page.Home -> Page.Plan(PMode.JustMap * Missions)
goToDevices :: Page.Home -> Page.Devices
planBackToHome :: Page.Plan(PMode.JustMap * Missions) -> Page.Home
devicesBackToHome :: Page.Devices -> Page.Home
newPlot :: Page.Plan => PMode.JustMap * Missions -> PMode.Plot(PlotOrigin.Draft * Plot.Empty) * Missions
        :: Page.Plan => PMode.ShowMission.List * Missions -> PMode.Plot(PlotOrigin.Draft * Plot.Empty) * Missions
showMission :: Page.Plan => PMode.JustMap * Missions -> PMode.ShowMission.List * Missions
selectMission :: Page.Plan => PMode.ShowMission.List.NonEmpty -> PMode.ShowMission.Selected
editMission :: Page.Plan => PMode.ShowMission.Selected(Mission(Plot#p)) -> PMode.Plot(PlotOrigin.Editing * p)
startFlight :: Page.Plan => PMode.Plot(Plot.Drawn(Boundary(Ring.Enclosed))) -> PMode.Flight(Flight.Arming)
takeOff :: App => Page.Plan(PMode.Flight(Flight.Arming)) * BatteryCharge#c // c >= MinTakeoffCharge -> Page.Plan(PMode.Flight(Flight.Flying))
flightFailed FailureReason#r :: Flight.{Arming | Flying} -> Flight.Failed(r)
landed :: Page.Plan => PMode.Flight(Flight.Flying) -> PMode.JustMap * Missions'
dismissFailure :: Page.Plan => PMode.Flight(Flight.Failed) -> PMode.JustMap
batteryChanged :: App => BatteryCharge -> BatteryCharge'
