-- A transition may take an input, written after its name.
__version 1.0

__atomics { Id Text }
__txs { rename pick select }

App = Items * Selection
Items = [Item]
Item = Id * Name * State
Name = Text
State = Off | On
Selection = None | Some Id
Ref = Id * Name

rename Name :: Item(Name) -> Item(Name')
pick [Id] :: Selection.None -> Selection.Some(Id)
-- Every signature writes the input.
select Ref :: State.Off -> State.On
select Ref :: State.On -> State.Off
