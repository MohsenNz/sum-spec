__atomics {
  Id
}

__events {
  toggle
  edit
  open
}

App = Page
Page = Home | Plan (Mode * Items)
Mode = View | Edit
Items = [Item by Id]
Item = Done | Todo
toggle Id#i :: Items[i] => Item.Done -> Item.Todo
            :: Items[i] => Item.Todo -> Item.Done
edit :: Page.Plan => Mode.View * Items -> Mode.Edit * Items'
open :: App => Page.Plan => Mode.View -> Mode.Edit
