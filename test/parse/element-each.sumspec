-- An element path over each element that matches, L[#x]: in a pattern,
-- in a shared path, with and without arguments. x names each element's
-- key; the target may write L[x].
__version 1.0

__atomics { Path }
__events { commit reset bump }

App = Files * Counts
Files = [FileState by Path]
FileState = Unmodified | Staged
Counts = [Count by Path]
Count = Path

commit :: Files[ #p ] => FileState.Staged -> FileState.Unmodified
reset :: App(Files[#p]) -> App(Files[p](FileState.Unmodified))
bump
  :: Counts[#p](Count#n)
  -> Counts[p](Count(n))
