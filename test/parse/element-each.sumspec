-- An element path over each element that matches, L[_]: in a pattern, in
-- a shared path, with and without arguments. The printer writes [_].
__version 1.0

__atomics { Path }
__events { commit reset bump }

App = Files * Counts
Files = [FileState by Path]
FileState = Unmodified | Staged
Counts = [Count]
Count = Path

commit :: Files[ _ ] => FileState.Staged -> FileState.Unmodified
reset :: App(Files[_]) -> App(Files[_](FileState.Unmodified))
bump
  :: Counts[_](Count#n)
  -> Counts[_](Count(n))
