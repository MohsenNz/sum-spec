__version 1.0

__atomics {
  Meters
  Hectares
  Timestamp
  Text
  FailureReason
  Point
  Settings
}

__events {
  goToPlan
  goToDevices
  planBackToHome
  devicesBackToHome
  newPlot
  showMission
  selectMission
  editMission
  startFlight
  takeOff
  flightFailed
  landed
  dismissFailure
}

-- The app starts on the home page.
__init :: App(Page.Home)

App
  = Page
  * Settings

Page
  = Home
  | Plan    (PMode * Missions)
  | Devices

PMode
  = JustMap
  | Plot (PlotOrigin * Plot)
  | Flight Flight
  | ShowMission
      ( List
          ( Empty
          | NonEmpty MissionSummaries )
      | Selected Mission )

Flight
  = Arming
  | Flying
  | Failed FailureReason

MissionSummaries = [MissionSummary]

MissionSummary = MissionName * At * Area * Distance * MissionState

PlotOrigin = Draft | Editing

Missions = [Mission]

Mission
  = MissionName
  * At
  * Area
  * Distance
  * MissionState
  * Plot

MissionName = Text

At = Timestamp

Area = Hectares

Distance = Meters

MissionState
  = NotStarted
  | Completed
  | Stopped     (StopReason * BreakPoint)

StopReason = Commanded | BatteryLow | LinkLost

BreakPoint = Point

Plot
  = Empty
  | Drawn
      ( Boundary
      * Markings )

Boundary = Ring

Markings = [Marking]

Marking
  = Obstacle      Ring
  | RoundObstacle Spot
  | PowerLine     Path
  | NonSprayArea  Ring
  | MarkPoint     Spot

Ring
  = Partial   Points
  | Closeable Points
  | Enclosed  Points

Path
  = Partial Point
  | Total   Points

Points = [Point]

Spot = Point

goToPlan          :: Page.Home -> Page.Plan(PMode.JustMap * Missions)
goToDevices       :: Page.Home -> Page.Devices
planBackToHome    :: Page.Plan(PMode.JustMap * Missions) -> Page.Home
devicesBackToHome :: Page.Devices -> Page.Home

newPlot       :: Page.Plan(PMode.JustMap * Missions)
              -> Page.Plan(PMode.Plot(PlotOrigin.Draft * Plot.Empty) * Missions)

newPlot       :: Page.Plan(PMode.ShowMission.List * Missions)
              -> Page.Plan(PMode.Plot(PlotOrigin.Draft * Plot.Empty) * Missions)

showMission   :: Page.Plan(PMode.JustMap * Missions)
              -> Page.Plan(PMode.ShowMission.List * Missions)

-- The mission list may have any value here: a new state.
selectMission :: Page.Plan(PMode.ShowMission.List.NonEmpty)
              -> Page.Plan(PMode.ShowMission.Selected)

-- Edits the selected mission's plot.
editMission   :: Page.Plan(PMode.ShowMission.Selected(Mission(Plot#p)))
              -> Page.Plan(PMode.Plot(PlotOrigin.Editing * p))

-- Flies a plot whose boundary is closed.
startFlight   :: Page.Plan(PMode.Plot(Plot.Drawn(Boundary(Ring.Enclosed))))
              -> Page.Plan(PMode.Flight(Flight.Arming))

takeOff       :: Flight.Arming -> Flight.Flying

-- An occurrence: the drone reports why the flight failed.
flightFailed FailureReason#r :: Flight.Arming -> Flight.Failed(r)
flightFailed FailureReason#r :: Flight.Flying -> Flight.Failed(r)

-- An occurrence: the drone is back on the ground. The flight is saved
-- as a mission, so Missions gets a new value.
landed         :: Page.Plan(PMode.Flight(Flight.Flying))
               -> Page.Plan(PMode.JustMap * Missions')

-- The user closes the failure report and is back at the map.
dismissFailure :: Page.Plan(PMode.Flight(Flight.Failed))
               -> Page.Plan(PMode.JustMap)
