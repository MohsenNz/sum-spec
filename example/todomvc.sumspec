-- TodoMVC (https://todomvc.com): the user interface of the todo-list app
-- that many web frameworks implement to the same spec.
--
-- The screen has a text box for new todos, the list of todos, and a
-- footer with the number of items left, the filters, and a "Clear
-- completed" button. The list and the footer are hidden while there are
-- no todos.
--
-- Todos is a keyed list: each todo is identified by its TodoId, which the
-- list holds. An event on one todo takes a TodoId, and picks the todo
-- with an element path, written once for both sides with =>
-- (Todos[id] => Completion.Active -> Completion.Completed).
--
-- A guard (// ...) restricts a transition by a condition on the state.
-- Here, a todo with an empty title is not added.

__version 1.0

__atomics {
  Text = __text  -- what the user types
  Count = __int  -- how many todos
  TodoId
}

__events {
  startTyping
  addTodo
  toggleTodo
  toggleAll
  startEditing
  finishEditing
  cancelEditing
  deleteTodo
  clearCompleted
  showAll
  showActive
  showCompleted
}

-- The app starts with no todos, an empty text box, and all todos shown.
__init :: App(Screen.NoTodos * NewTodo.Blank * Filter.All)

App
  = Screen
  * NewTodo
  * Filter

NewTodo
  = Blank
  | Typing Text

Screen
  = NoTodos
  | WithTodos (Todos * ToggleAll * Footer)

Todos = [Todo by TodoId]

Todo
  = Title
  * Completion
  * RowMode

Title = Text

Completion
  = Active
  | Completed

RowMode
  = Viewing
  | Editing EditText

EditText = Text

ToggleAll
  = NotAllDone
  | AllDone

Footer
  = ItemsLeft
  * ClearCompleted

ItemsLeft = Count

ClearCompleted
  = Hidden
  | Shown

Filter
  = All
  | Active
  | Completed

startTyping Text#t :: NewTodo.Blank -> NewTodo.Typing(t)

addTodo
  :: App
  => Screen.NoTodos * NewTodo.Typing(#text)
  // text != ""
  -> Screen.WithTodos(ToggleAll.NotAllDone) * NewTodo.Blank

  => Screen.WithTodos * NewTodo.Typing(#text)
  // text != ""
  -> Screen.WithTodos(Todos' * ToggleAll.NotAllDone * Footer(ItemsLeft')) * NewTodo.Blank

toggleTodo TodoId#id
  :: Todos[id]
  => Completion.Active -> Completion.Completed
  => Completion.Completed -> Completion.Active

toggleAll :: ToggleAll.NotAllDone -> ToggleAll.AllDone
          :: ToggleAll.AllDone -> ToggleAll.NotAllDone

startEditing TodoId#id :: Todos[id] => Title(#title) * RowMode.Viewing
                                    -> RowMode.Editing(EditText(title))

finishEditing TodoId#id :: Todos[id] => RowMode.Editing(EditText(#e))
                                     -> Title(e) * RowMode.Viewing

cancelEditing TodoId#id :: Todos[id] => RowMode.Editing -> RowMode.Viewing

deleteTodo TodoId#id :: Screen.WithTodos => Todos[id]
                                         -> Todos' * ToggleAll' * Footer'

                     :: Screen.WithTodos(Todos[id]) -> Screen.NoTodos

clearCompleted :: Screen.WithTodos => Footer(ClearCompleted.Shown)
                                   -> Todos'
                                    * ToggleAll.NotAllDone
                                    * Footer(ClearCompleted.Hidden)

               :: Screen.WithTodos(Footer(ClearCompleted.Shown))
               -> Screen.NoTodos

showAll :: Filter -> Filter.All
showActive :: Filter -> Filter.Active
showCompleted :: Filter -> Filter.Completed
