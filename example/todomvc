-- TodoMVC (https://todomvc.com): the user interface of the todo-list app
-- that many web frameworks implement to the same spec.
--
-- The screen has a text box for new todos, the list of todos, and a
-- footer with the number of items left, the filters, and a "Clear
-- completed" button. The list and the footer are hidden while there are
-- no todos.
--
-- Todos is a keyed list: each todo is identified by its TodoId, which the
-- list holds. A transition on one todo takes a TodoId, and picks the todo
-- with an element path (Todos[id](...)).

__version 1.0

__atomics {
  Text
  Count
  TodoId
}

__txs {
  startTyping
  addTodo
  toggleTodo
  toggleAll
  startEditing
  finishEditing
  cancelEditing
  deleteTodo
  clearCompleted
  showAll
  showActive
  showCompleted
}

App
  = Screen
  * NewTodo
  * Filter

NewTodo
  = Blank
  | Typing Text

Screen
  = NoTodos
  | WithTodos (Todos * ToggleAll * Footer)

Todos = [Todo by TodoId]

Todo
  = Title
  * Completion
  * RowMode

Title = Text

Completion
  = Active
  | Completed

RowMode
  = Viewing
  | Editing EditText

EditText = Text

ToggleAll
  = NotAllDone
  | AllDone

Footer
  = ItemsLeft
  * ClearCompleted

ItemsLeft = Count

ClearCompleted
  = Hidden
  | Shown

Filter
  = All
  | Active
  | Completed

startTyping Text#t :: NewTodo.Blank -> NewTodo.Typing(t)

addTodo :: App(Screen.NoTodos * NewTodo.Typing)
        -> App(Screen.WithTodos(ToggleAll.NotAllDone) * NewTodo.Blank)

addTodo :: App(Screen.WithTodos * NewTodo.Typing)
        -> App(Screen.WithTodos(Todos' * ToggleAll.NotAllDone * Footer(ItemsLeft')) * NewTodo.Blank)

toggleTodo TodoId#id :: Todos[id](Completion.Active) -> Todos[id](Completion.Completed)
toggleTodo TodoId#id :: Todos[id](Completion.Completed) -> Todos[id](Completion.Active)

toggleAll :: ToggleAll.NotAllDone -> ToggleAll.AllDone
toggleAll :: ToggleAll.AllDone -> ToggleAll.NotAllDone

startEditing TodoId#id :: Todos[id](Title(Text#t) * RowMode.Viewing)
                       -> Todos[id](RowMode.Editing(EditText(t)))

finishEditing TodoId#id :: Todos[id](RowMode.Editing(EditText(Text#e)))
                        -> Todos[id](Title(e) * RowMode.Viewing)

cancelEditing TodoId#id :: Todos[id](RowMode.Editing) -> Todos[id](RowMode.Viewing)

deleteTodo TodoId#id :: Screen.WithTodos(Todos[id])
                     -> Screen.WithTodos(Todos' * ToggleAll' * Footer')
deleteTodo TodoId#id :: Screen.WithTodos(Todos[id]) -> Screen.NoTodos

clearCompleted :: Screen.WithTodos(Footer(ClearCompleted.Shown))
               -> Screen.WithTodos( Todos'
                                  * ToggleAll.NotAllDone
                                  * Footer(ClearCompleted.Hidden))

clearCompleted :: Screen.WithTodos(Footer(ClearCompleted.Shown))
               -> Screen.NoTodos

showAll :: Filter -> Filter.All
showActive :: Filter -> Filter.Active
showCompleted :: Filter -> Filter.Completed
