-- Git (https://git-scm.com): the core of a local repository. It covers
-- HEAD, the branches, the life cycle of each file (untracked, modified,
-- staged, committed), and the operations that can be left in progress:
-- a merge with conflicts, and a rebase.
--
-- An event with several transitions describes its effect on each part
-- of the state, e.g. "commit" moves the branch's tip and also turns
-- staged files into unmodified ones.
--
-- On the target side of a transition, a part that is left out, or
-- written without a prime, keeps its value; a primed part (Files') gets
-- a new value. See "Source and target" in spec/spec-v1.md.
--
-- Files and Branches are keyed lists: a file is identified by its Path,
-- and a branch by its BranchName. An event on one file takes a Path
-- and picks the file with an element path, written once for both sides
-- with => (Files[p] => FileState.Staged -> FileState.Modified).

__version 1.0

__atomics {
  Hash
  BranchName
  Path
}

__events {
  init
  edit
  add
  unstage
  restore
  commit
  switch
  checkoutCommit
  merge
  resolve
  mergeContinue
  mergeAbort
  rebase
  rebaseContinue
  rebaseAbort
}

-- A repository starts uninitialized, until git init.
__init :: Repository.Uninitialized

Repository
  = Uninitialized
  | Initialized (Head * Branches * Files * Operation)

Head
  = Unborn BranchName
  | OnBranch BranchName
  | Detached Hash

Branches = [Tip by BranchName]

Tip = Hash

Files = [FileState by Path]

FileState
  = Untracked
  | Unmodified
  | Modified
  | Staged
  | StagedAndModified
  | Conflicted

Operation
  = Idle
  | Merging MergeHead
  | Rebasing (Onto * Remaining)

MergeHead = Hash

Onto = Hash

Remaining = [Hash]

init
  :: Repository.Uninitialized
  -> Repository.Initialized(Head.Unborn * Operation.Idle)

edit Path#p
  :: Files[p] => FileState.Unmodified -> FileState.Modified
  :: Files[p] => FileState.Staged -> FileState.StagedAndModified

add Path#p
  :: Files[p] => FileState.Untracked -> FileState.Staged
  :: Files[p] => FileState.Modified -> FileState.Staged
  :: Files[p] => FileState.StagedAndModified -> FileState.Staged

unstage Path#p
  :: Files[p] => FileState.Staged -> FileState.Modified
  :: Files[p] => FileState.StagedAndModified -> FileState.Modified

restore Path#p
  :: Files[p] => FileState.Modified -> FileState.Unmodified
  :: Files[p] => FileState.StagedAndModified -> FileState.Staged

commit
  :: Repository.Initialized
  => Head.Unborn * Operation.Idle
  -> Head.OnBranch * Branches' * Files'

  :: Repository.Initialized
  => Head.OnBranch * Operation.Idle
  -> Branches' * Files'

  -- Every staged file becomes unmodified. SumSpec can't say "every" yet,
  -- so the checker warns that this doesn't say which file.
  :: FileState.Staged -> FileState.Unmodified

switch 
  :: Repository.Initialized
  => Operation.Idle
  -> Head.OnBranch * Files'

checkoutCommit
  :: Repository.Initialized
  => Operation.Idle
  -> Head.Detached * Files'

merge
  :: Repository.Initialized
  => Head.OnBranch * Operation.Idle
  -> Branches' * Files'

  :: Repository.Initialized
  => Head.OnBranch * Operation.Idle
  -> Files' * Operation.Merging

  -- The files both sides changed become conflicted. SumSpec can't say
  -- which yet, so the checker warns.
  :: FileState.Unmodified -> FileState.Conflicted

resolve Path#p
  :: Files[p] => FileState.Conflicted -> FileState.Staged

mergeContinue
  :: Repository.Initialized
  => Operation.Merging
  -> Branches' * Operation.Idle

mergeAbort
  :: Repository.Initialized
  => Operation.Merging
  -> Files' * Operation.Idle

  -- Every conflicted file goes back to unmodified; the checker warns, as
  -- for commit.
  :: FileState.Conflicted -> FileState.Unmodified

rebase
  :: Repository.Initialized
  => Head.OnBranch * Operation.Idle
  -> Head.Detached * Files' * Operation.Rebasing

rebaseContinue
  :: Repository.Initialized
  => Head.Detached * Operation.Rebasing
  -> Head.Detached(Hash') * Files' * Operation.Rebasing(Remaining')

  :: Repository.Initialized
  => Head.Detached * Operation.Rebasing
  -> Head.OnBranch * Branches' * Operation.Idle

rebaseAbort
  :: Repository.Initialized
  => Head.Detached * Operation.Rebasing
  -> Head.OnBranch * Files' * Operation.Idle
