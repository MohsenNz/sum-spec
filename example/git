-- Git (https://git-scm.com): the core of a local repository. It covers
-- HEAD, the branches, the life cycle of each file (untracked, modified,
-- staged, committed), and the operations that can be left in progress:
-- a merge with conflicts, and a rebase.
--
-- An event with several transitions describes its effect on each part
-- of the state, e.g. "commit" moves the branch's tip and also turns
-- staged files into unmodified ones.
--
-- On the target side of a transition, a part that is left out, or
-- written without a prime, keeps its value; a primed part (Files') gets
-- a new value. See "Source and target" in spec/spec-v1.md.
--
-- Files and Branches are keyed lists: a file is identified by its Path,
-- and a branch by its BranchName. An event on one file takes a Path
-- and picks the file with an element path (Files[p](...)).

__version 1.0

__atomics {
  Hash
  BranchName
  Path
}

__events {
  init
  edit
  add
  unstage
  restore
  commit
  switch
  checkoutCommit
  merge
  resolve
  mergeContinue
  mergeAbort
  rebase
  rebaseContinue
  rebaseAbort
}

App = Repository

Repository
  = Uninitialized
  | Initialized (Head * Branches * Files * Operation)

Head
  = Unborn BranchName
  | OnBranch BranchName
  | Detached Hash

Branches = [Tip by BranchName]

Tip = Hash

Files = [FileState by Path]

FileState
  = Untracked
  | Unmodified
  | Modified
  | Staged
  | StagedAndModified
  | Conflicted

Operation
  = Idle
  | Merging MergeHead
  | Rebasing (Onto * Remaining)

MergeHead = Hash

Onto = Hash

Remaining = [Hash]

init :: Repository.Uninitialized
     -> Repository.Initialized(Head.Unborn * Operation.Idle)

edit Path#p :: Files[p](FileState.Unmodified) -> Files[p](FileState.Modified)
edit Path#p :: Files[p](FileState.Staged) -> Files[p](FileState.StagedAndModified)

add Path#p :: Files[p](FileState.Untracked) -> Files[p](FileState.Staged)
add Path#p :: Files[p](FileState.Modified) -> Files[p](FileState.Staged)
add Path#p :: Files[p](FileState.StagedAndModified) -> Files[p](FileState.Staged)

unstage Path#p :: Files[p](FileState.Staged) -> Files[p](FileState.Modified)
unstage Path#p :: Files[p](FileState.StagedAndModified) -> Files[p](FileState.Modified)

restore Path#p :: Files[p](FileState.Modified) -> Files[p](FileState.Unmodified)
restore Path#p :: Files[p](FileState.StagedAndModified) -> Files[p](FileState.Staged)

commit :: Repository.Initialized(Head.Unborn * Operation.Idle)
       -> Repository.Initialized(Head.OnBranch * Branches' * Files')

commit :: Repository.Initialized(Head.OnBranch * Operation.Idle)
       -> Repository.Initialized(Branches' * Files')

-- Every staged file becomes unmodified. SumSpec can't say "every" yet,
-- so the checker warns that this doesn't say which file.
commit :: FileState.Staged -> FileState.Unmodified

switch :: Repository.Initialized(Operation.Idle)
       -> Repository.Initialized(Head.OnBranch * Files')

checkoutCommit :: Repository.Initialized(Operation.Idle)
               -> Repository.Initialized(Head.Detached * Files')

merge :: Repository.Initialized(Head.OnBranch * Operation.Idle)
      -> Repository.Initialized(Branches' * Files')

merge :: Repository.Initialized(Head.OnBranch * Operation.Idle)
      -> Repository.Initialized(Files' * Operation.Merging)

-- The files both sides changed become conflicted. SumSpec can't say
-- which yet, so the checker warns.
merge :: FileState.Unmodified -> FileState.Conflicted

resolve Path#p :: Files[p](FileState.Conflicted) -> Files[p](FileState.Staged)

mergeContinue :: Repository.Initialized(Operation.Merging)
              -> Repository.Initialized(Branches' * Operation.Idle)

mergeAbort :: Repository.Initialized(Operation.Merging)
           -> Repository.Initialized(Files' * Operation.Idle)

-- Every conflicted file goes back to unmodified; the checker warns, as
-- for commit.
mergeAbort :: FileState.Conflicted -> FileState.Unmodified

rebase :: Repository.Initialized(Head.OnBranch * Operation.Idle)
       -> Repository.Initialized(Head.Detached * Files' * Operation.Rebasing)

rebaseContinue :: Repository.Initialized(Head.Detached * Operation.Rebasing)
               -> Repository.Initialized(Head.Detached(Hash') * Files' * Operation.Rebasing(Remaining'))

rebaseContinue :: Repository.Initialized(Head.Detached * Operation.Rebasing)
               -> Repository.Initialized(Head.OnBranch * Branches' * Operation.Idle)

rebaseAbort :: Repository.Initialized(Head.Detached * Operation.Rebasing)
            -> Repository.Initialized(Head.OnBranch * Files' * Operation.Idle)
