cabal-version:      3.0
name:               sumspec
version:            0.1.0.0
synopsis:           Parser and type checker for the SumSpec specification language
description:
  SumSpec describes an application as sum and product types and state
  transitions.

license:            NONE
author:             Mohsen
maintainer:         thelight.mn@gmail.com
category:           Language
build-type:         Simple
extra-doc-files:
  CHANGES.md
  README.md
extra-source-files:
  example/drone.sumspec
  example/git.sumspec
  example/todomvc.sumspec
  spec/grammar.ebnf

common common
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

  build-depends:    base >=4.20 && <5

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    SumSpec
    SumSpec.Check
    SumSpec.Model
    SumSpec.Parser
    SumSpec.Pretty
    SumSpec.Syntax
    SumSpec.Version

  other-modules:   SumSpec.Lexer
  build-depends:
    , containers  >=0.7  && <0.9
    , megaparsec  >=9.7  && <10
    , text        >=2.1  && <2.2

-- The language server. A library of its own, so the core library above
-- keeps its few dependencies.
library sumspec-lsp
  import:          common
  hs-source-dirs:  lsp
  exposed-modules: SumSpec.Lsp
  other-modules:
    SumSpec.Lsp.Completion
    SumSpec.Lsp.Hover
    SumSpec.Lsp.Index
    SumSpec.Lsp.Position
    SumSpec.Lsp.Tokens

  build-depends:
    , containers    >=0.7  && <0.9
    , lsp           >=2.7  && <2.9
    , lsp-types     >=2.3  && <2.5
    , megaparsec    >=9.7  && <10
    , sumspec
    , text          >=2.1  && <2.2

executable sumspec
  import:         common
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , sumspec
    , sumspec-lsp
    , text         >=2.1 && <2.2

  ghc-options:    -threaded -rtsopts

test-suite sumspec-test
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -rtsopts "-with-rtsopts=-M2G"
  build-depends:
    , bytestring    >=0.12 && <0.13
    , filepath      >=1.5  && <1.6
    , sumspec
    , tasty         >=1.5  && <1.6
    , tasty-golden  >=2.3  && <2.4
    , text          >=2.1  && <2.2

-- The language server, run in-process and driven by lsp-test.
test-suite sumspec-lsp-test
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: test/lsp
  main-is:        Main.hs
  build-depends:
    , lsp          >=2.7  && <2.9
    , lsp-test     >=0.17 && <0.18
    , lsp-types    >=2.3  && <2.5
    , process      >=1.6  && <1.7
    , sumspec-lsp
    , tasty        >=1.5  && <1.6
    , tasty-hunit  >=0.10 && <0.11
    , text         >=2.1  && <2.2

  ghc-options:    -threaded
